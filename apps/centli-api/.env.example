# --- Server (uvicorn) ---
HOST=127.0.0.1
PORT=8000
SLOW_REQUEST_MS=1000

# --- SecureVault (src/vault.py) ---
# VAULT_PATH: encrypted vault file, created on first boot.
# MASTER_KEY_FILE: path to a file with the master secret. Must exist and be
# non-empty, otherwise the app fails on startup. Never commit it.
VAULT_PATH=./.data/secrets.vault
MASTER_KEY_FILE=./.secrets/vault_master_key

# --- Database ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=centli-db
DATABASE_ROLE=centli-api
DATABASE_PASSWORD=
